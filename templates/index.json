      "block_order": ["cat_1", "cat_2", "cat_3", "cat_4", "cat_5", "cat_6"],
      "settings": {
        "title": "Shop by Category",
        "subtitle": "Curated collections for every moment",
        "link_label": "View All"
      }
    },
    "sumix_best_sellers": {
      "type": "sumix-collection",
