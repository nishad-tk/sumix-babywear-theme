    },
    "sumix_testimonials": {
      "type": "sumix-testimonials",
      "blocks": {
        "test_1": { "type": "testimonial", "settings": { "author": "Anjali Nair", "location": "Kochi, Kerala", "quote": "The fabric is unbelievably soft and perfect for Kerala's weather. My baby sleeps so peacefully in the Dreamy Nights set. Worth every rupee!" } },
        "test_2": { "type": "testimonial", "settings": { "author": "Rahul Menon", "location": "Bangalore", "quote": "I've tried many brands but SUMIX is genuinely different. The organic cotton feels luxurious and the designs are so thoughtful. My go-to for baby gifts now." } },
        "test_3": { "type": "testimonial", "settings": { "author": "Priya Sharma", "location": "Mumbai", "quote": "The child profile feature is brilliant! I get size recommendations exactly when my daughter needs them. The birthday rewards are such a sweet touch too." } }
      },
      "block_order": ["test_1", "test_2", "test_3"],
      "settings": {
        "title": "Loved by Parents, Adored by Babies",
        "subtitle": "Real stories from our SUMIX family"
      }
    },
    "sumix_rewards_banner": {
      "type": "sumix-rewards-banner",
