{
  "sections": {
    "sumix_banner_carousel": {
      "type": "sumix-banner-carousel",
      "blocks": {
        "slide_1": {
          "type": "slide",
          "settings": {
            "title": "Summer Collection",
            "subheading": "Soft, breathable organic cotton for everyday play.",
            "button_label": "Shop Now",
            "button_link": "shopify:\/\/collections\/all"
          }
        },
        "slide_2": {
          "type": "slide",
          "settings": {
            "title": "Flat 20% Off",
            "subheading": "On all newborn essentials.",
            "button_label": "Explore",
            "button_link": "shopify:\/\/collections\/all"
          }
        }
      },
      "block_order": [
        "slide_1",
        "slide_2"
      ],
      "settings": {
        "autoplay": true,
        "interval": 5
      }
    },
    "sumix_trust_bar": {
      "type": "sumix-trust-bar",
      "blocks": {
        "block_1": {
          "type": "trust_feature",
          "settings": { "icon": "🌿", "title": "Organic Cotton", "text": "100% GOTS certified" }
        },
        "block_2": {
          "type": "trust_feature",
          "settings": { "icon": "🚚", "title": "Free Shipping", "text": "On orders above ₹999" }
        },
        "block_3": {
          "type": "trust_feature",
          "settings": { "icon": "↩️", "title": "Easy Returns", "text": "7-day hassle-free returns" }
        },
        "block_4": {
          "type": "trust_feature",
          "settings": { "icon": "🔒", "title": "Secure Payments", "text": "100% protected checkout" }
        }
      },
      "block_order": ["block_1", "block_2", "block_3", "block_4"],
      "settings": {}
    },
    "sumix_shop_by_age": {
      "type": "sumix-shop-by-age",
      "blocks": {
        "age_1": { "type": "age_group", "settings": { "emoji": "👶", "title": "Newborn", "subtitle": "0–3 Months" } },
        "age_2": { "type": "age_group", "settings": { "emoji": "🍼", "title": "Infant", "subtitle": "3–6 Months" } },
        "age_3": { "type": "age_group", "settings": { "emoji": "🧸", "title": "Baby", "subtitle": "6–12 Months" } },
        "age_4": { "type": "age_group", "settings": { "emoji": "🎈", "title": "Toddler", "subtitle": "1–2 Years" } },
        "age_5": { "type": "age_group", "settings": { "emoji": "🌟", "title": "Kid", "subtitle": "2–4 Years" } }
      },
      "block_order": ["age_1", "age_2", "age_3", "age_4", "age_5"],
      "settings": {
        "title": "Whose wardrobe are you shopping for?",
        "subtitle": "Personalized picks for your little one"
      }
    },
    "sumix_shop_by_category": {
      "type": "sumix-shop-by-category",
      "blocks": {
        "cat_1": { "type": "category", "settings": { "title": "Rompers" } },
        "cat_2": { "type": "category", "settings": { "title": "Onesies" } },
        "cat_3": { "type": "category", "settings": { "title": "Dresses" } },
        "cat_4": { "type": "category", "settings": { "title": "Sleepwear" } },
        "cat_5": { "type": "category", "settings": { "title": "Essentials" } },
        "cat_6": { "type": "category", "settings": { "title": "Gift Sets" } }
