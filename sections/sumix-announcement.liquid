<div class="announcement-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="announcement-track">
    {% for block in section.blocks %}
      <div class="announcement-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="announcement-item">{{ block.settings.text }}</div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Sumix Announcement",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6B3FA0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "🚚 Free Shipping Above ₹999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Announcement",
      "blocks": [
        { "type": "announcement", "settings": { "text": "🚚 Free Shipping Above ₹999" } },
        { "type": "announcement", "settings": { "text": "🌿 100% Organic Cotton Collection" } },
        { "type": "announcement", "settings": { "text": "↩️ Easy 7-Day Returns" } },
        { "type": "announcement", "settings": { "text": "💳 Cash on Delivery Available" } }
      ]
    }
  ]
}
{% endschema %}
