{% style %}
  .product-trust-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .product-trust-sumix-{{ section.id }} .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .product-trust-sumix-{{ section.id }} .trust-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .product-trust-sumix-{{ section.id }} .trust-item {
    display: flex;
    flex-direction: {% if section.settings.layout == 'horizontal' %}row{% else %}column{% endif %};
    align-items: {% if section.settings.layout == 'horizontal' %}flex-start{% else %}center{% endif %};
    text-align: {% if section.settings.layout == 'horizontal' %}left{% else %}center{% endif %};
    gap: 1.25rem;
    padding: {{ section.settings.item_padding }}px;
    background-color: {{ section.settings.card_bg_color }};
    border-radius: 16px;
    {% if section.settings.show_border %}
      border: 1px solid rgba(0,0,0,0.06);
    {% endif %}
    {% if section.settings.show_shadow %}
      box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    {% endif %}
  }

  .product-trust-sumix-{{ section.id }} .trust-icon {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    color: {{ section.settings.icon_color }};
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-trust-sumix-{{ section.id }} .trust-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .product-trust-sumix-{{ section.id }} .trust-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .product-trust-sumix-{{ section.id }} .trust-title {
    font-weight: 700;
    font-size: 1.0625rem;
    margin: 0;
    color: {{ section.settings.text_color }};
    line-height: 1.2;
  }

  .product-trust-sumix-{{ section.id }} .trust-text {
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.75;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  @media (max-width: 900px) {
    .product-trust-sumix-{{ section.id }} .trust-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .product-trust-sumix-{{ section.id }} .trust-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 1rem;
    }
    {% if section.settings.layout == 'vertical' %}
      .product-trust-sumix-{{ section.id }} .trust-item {
        padding: 1.5rem;
      }
    {% endif %}
  }
{% endstyle %}

<div class="product-trust-sumix-{{ section.id }}">
  <div class="container">
    <div class="trust-grid">
      {% for block in section.blocks %}
        <div class="trust-item" {{ block.shopify_attributes }}>
          
          <div class="trust-icon">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% else %}
              <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            {% endif %}
          </div>
          
          <div class="trust-content">
            {% if block.settings.title != blank %}
              <h4 class="trust-title">{{ block.settings.title }}</h4>
            {% endif %}
            
            {% if block.settings.text != blank %}
              <p class="trust-text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
          
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sumix Product Highlights",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Card Layout",
      "options": [
        { "value": "vertical", "label": "Vertical (Icon on Top, Centered)" },
        { "value": "horizontal", "label": "Horizontal (Icon on Left)" }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Grid Gap Spacing",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Card Padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Soft Border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show Subtle Shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#6D28D9"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust Point",
      "limit": 6,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste raw SVG code here."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Soft Fabric"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Gentle on sensitive skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Product Highlights",
      "blocks": [
        {
          "type": "trust_point",
          "settings": {
            "title": "GOTS Certified",
            "text": "100% organic, chemical-free cotton.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "title": "Fast Delivery",
            "text": "Dispatched within 24 hours.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\"/></svg>"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "title": "Easy Returns",
            "text": "Hassle-free 15-day returns.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11h-4v4h-2v-4H7v-2h4V7h2v4h4v2z\"/></svg>"
          }
        },
        {
          "type": "trust_point",
          "settings": {
            "title": "Gifting Ready",
            "text": "Beautiful packaging for perfect gifts.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76l1-1.36 1 1.36L15.38 12 17 10.83 14.92 8H20v6z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
