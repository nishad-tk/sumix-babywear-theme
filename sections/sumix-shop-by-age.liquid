<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      </div>
    </div>
    <div class="age-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="age-card" {{ block.shopify_attributes }}>
          <div class="age-avatar">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.title }}">
            {% else %}
              {{ block.settings.emoji }}
            {% endif %}
          </div>
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.subtitle }}</p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sumix Shop By Age",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Whose wardrobe are you shopping for?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Personalized picks for your little one"
    }
  ],
  "blocks": [
    {
      "type": "age_group",
      "name": "Age Group",
      "settings": [
        {
          "type": "text",
          "id": "emoji",
          "label": "Emoji (fallback)",
          "default": "👶"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Newborn"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Age Range",
          "default": "0–3 Months"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Shop By Age",
      "blocks": [
        { "type": "age_group", "settings": { "emoji": "👶", "title": "Newborn", "subtitle": "0–3 Months" } },
        { "type": "age_group", "settings": { "emoji": "🍼", "title": "Infant", "subtitle": "3–6 Months" } },
        { "type": "age_group", "settings": { "emoji": "🧸", "title": "Baby", "subtitle": "6–12 Months" } },
        { "type": "age_group", "settings": { "emoji": "🎈", "title": "Toddler", "subtitle": "1–2 Years" } },
        { "type": "age_group", "settings": { "emoji": "🌟", "title": "Kid", "subtitle": "2–4 Years" } }
      ]
    }
  ]
}
{% endschema %}
