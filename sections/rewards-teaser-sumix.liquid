{% style %}
  .rewards-teaser-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  .rewards-teaser-sumix-{{ section.id }} .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    gap: 6rem;
  }

  {% if section.settings.layout == 'image_right' %}
    .rewards-teaser-sumix-{{ section.id }} .container {
      flex-direction: row-reverse;
    }
  {% endif %}

  .rewards-teaser-sumix-{{ section.id }} .teaser-image {
    flex: 1;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 50px rgba(0,0,0,0.06);
  }

  .rewards-teaser-sumix-{{ section.id }} .teaser-image::before {
    content: "";
    display: block;
    padding-bottom: 100%; /* 1:1 Aspect Ratio */
  }

  .rewards-teaser-sumix-{{ section.id }} .teaser-image img,
  .rewards-teaser-sumix-{{ section.id }} .teaser-image svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  /* Decorative elements for the image */
  .rewards-teaser-sumix-{{ section.id }} .teaser-image-badge {
    position: absolute;
    bottom: -20px;
    right: -20px;
    width: 120px;
    height: 120px;
    background: {{ section.settings.icon_color }};
    color: var(--white);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    z-index: 2;
    transform: rotate(-10deg);
  }

  .rewards-teaser-sumix-{{ section.id }} .teaser-content {
    flex: 1;
    max-width: 500px;
  }
  
  .rewards-teaser-sumix-{{ section.id }} .teaser-eyebrow {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: {{ section.settings.icon_color }};
    margin-bottom: 1rem;
    display: block;
  }

  .rewards-teaser-sumix-{{ section.id }} .teaser-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1rem;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
  }

  .rewards-teaser-sumix-{{ section.id }} .teaser-text {
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 2.5rem;
    color: {{ section.settings.text_color }};
  }

  /* Benefits Grid */
  .rewards-teaser-sumix-{{ section.id }} .benefits-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin-bottom: 3rem;
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    color: {{ section.settings.icon_color }};
    background: rgba(0,0,0,0.04);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-title {
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .rewards-teaser-sumix-{{ section.id }} .benefit-text {
    font-size: 0.8125rem;
    opacity: 0.7;
    margin: 0;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
  }

  .rewards-teaser-sumix-{{ section.id }} .btn-rewards {
    background-color: var(--primary);
    color: var(--white);
    border: none;
    padding: 1rem 2.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .rewards-teaser-sumix-{{ section.id }} .btn-rewards:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .rewards-teaser-sumix-{{ section.id }} .container {
      flex-direction: column !important;
      gap: 3rem;
    }
    
    .rewards-teaser-sumix-{{ section.id }} .teaser-image {
      width: 100%;
      border-radius: 16px;
    }
    
    .rewards-teaser-sumix-{{ section.id }} .teaser-image-badge {
      width: 90px;
      height: 90px;
      font-size: 1.125rem;
      bottom: -10px;
      right: -10px;
    }
    
    .rewards-teaser-sumix-{{ section.id }} .teaser-content {
      max-width: 100%;
    }
    
    .rewards-teaser-sumix-{{ section.id }} .benefits-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
{% endstyle %}

<div class="rewards-teaser-sumix-{{ section.id }}">
  <div class="container">
    
    <div class="teaser-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" 
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" 
             loading="lazy">
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
      
      {% if section.settings.show_badge %}
        <div class="teaser-image-badge">Join Free</div>
      {% endif %}
    </div>

    <div class="teaser-content">
      {% if section.settings.eyebrow != blank %}
        <span class="teaser-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      
      {% if section.settings.heading != blank %}
        <h2 class="teaser-title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="teaser-text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="benefits-grid">
          {% for block in section.blocks %}
            <div class="benefit-item" {{ block.shopify_attributes }}>
              
              <div class="benefit-icon">
                {% if block.settings.icon_svg != blank %}
                  {{ block.settings.icon_svg }}
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>
              
              <div class="benefit-content">
                {% if block.settings.title != blank %}
                  <h4 class="benefit-title">{{ block.settings.title }}</h4>
                {% endif %}
                
                {% if block.settings.text != blank %}
                  <p class="benefit-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
              
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a href="{{ section.settings.cta_link }}" class="btn-rewards">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Sumix Rewards Teaser",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images & Layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image",
      "info": "Image will automatically adapt to a clean 1:1 square ratio."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show 'Join Free' circular badge over image",
      "default": true
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Placement",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_right"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Sumix Tokens"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our rewards program"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Main Text",
      "default": "<p>Earn tokens every time you shop. Redeem them for exclusive discounts, free shipping, and special perks for your little one.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Join the Club"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Accent / Icon Color",
      "default": "#EAB308",
      "info": "Used for the circular badge, icons, and eyebrow text."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Reward Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste raw SVG code for the icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Earn Tokens"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short Text",
          "default": "Earn 5 tokens for every ₹100 spent."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Rewards Teaser",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Shop & Earn",
            "text": "Earn 5 Tokens for every ₹100 spent on our store.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M22 11h-4l-3-9H3a2 2 0 0 0-2 2v16h2a3 3 0 0 0 6 0h6a3 3 0 0 0 6 0h1a2 2 0 0 0 2-2v-5c0-1.66-1.34-3-3-3zm-13 9a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm8 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm-1.5-6h-11V6h9.5l2.67 8z\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Birthday Perks",
            "text": "Get 100 bonus tokens automatically on your child's birthday.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 6.5a2.5 2.5 0 0 0 0-5 2.5 2.5 0 0 0 0 5z\"/><path d=\"M17 10h-1.5V7.5a1.5 1.5 0 0 0-3 0V10h-1V7.5a1.5 1.5 0 0 0-3 0V10H7v11a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V10z\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Early Access",
            "text": "Be the first to know about new arrivals and exclusive sales.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z\"/><path d=\"M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z\"/></svg>"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Refer a Friend",
            "text": "Give a discount, get 250 bonus tokens when they purchase.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
