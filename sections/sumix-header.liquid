<header class="header">
  <div class="container header-inner">
    <button class="mobile-menu-btn" aria-label="Menu" onclick="document.querySelector('.mobile-nav').classList.toggle('active')">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="logo">
      {% if section.settings.logo != blank %}
        <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="max-height: {{ section.settings.logo_height }}px">
      {% else %}
        <span class="logo-text">{{ shop.name }}</span>
        {% if section.settings.tagline != blank %}
          <span class="logo-tagline">{{ section.settings.tagline }}</span>
        {% endif %}
      {% endif %}
    </a>

    <nav class="nav-desktop">
      {% for link in linklists[section.settings.menu].links %}
        <a href="{{ link.url }}" class="nav-link {% if link.active %}active{% endif %}">{{ link.title }}</a>
      {% else %}
        <a href="{{ routes.root_url }}" class="nav-link active">Home</a>
        <a href="{{ routes.all_products_collection_url }}" class="nav-link">Catalog</a>
      {% endfor %}
    </nav>

    <div style="display:flex;align-items:center;gap:var(--space-2);flex:1;justify-content:flex-end">
      <form action="{{ routes.search_url }}" method="get" class="search-bar">
        <i>🔍</i>
        <input type="text" name="q" placeholder="Search for products..." value="{{ search.terms | escape }}">
      </form>

      <div class="header-actions">
        {% if shop.customer_accounts_enabled %}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="icon-btn" aria-label="Account">👤</a>
        {% endif %}
        
        <a href="/pages/wishlist" class="icon-btn" aria-label="Wishlist">
          🤍
          <span class="count wishlist-count" style="display:none">0</span>
        </a>
        <button class="icon-btn" aria-label="Cart" onclick="openCartDrawer()">
          🛒
          <span class="count cart-count" {% if cart.item_count == 0 %}style="display:none"{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Cart Drawer (Included globally via header) -->
<div class="cart-drawer-overlay" id="cart-overlay" onclick="closeCartDrawer()"></div>
<div class="cart-drawer" id="cart-drawer">
  <div class="cart-drawer-header">
    <h3>Your Bag</h3>
    <button class="icon-btn" onclick="closeCartDrawer()" aria-label="Close">✕</button>
  </div>
  <div class="cart-drawer-body" id="cart-drawer-body">
    <!-- Populated by JS -->
  </div>
  <div class="cart-drawer-footer" id="cart-drawer-footer">
    <!-- Populated by JS -->
  </div>
</div>

{% schema %}
{
  "name": "Sumix Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 100,
      "step": 2,
      "default": 40,
      "label": "Logo Height"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Text Tagline (if no logo)",
      "default": "baby wear & care"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Desktop Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Sumix Header"
    }
  ]
}
{% endschema %}
