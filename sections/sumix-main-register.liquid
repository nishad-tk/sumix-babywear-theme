<div class="auth-layout">
  <div class="auth-visual">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url: width: 500 }}" alt="{{ section.settings.title }}" style="max-width:360px;width:100%">
    {% else %}
      <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=500&h=600&fit=crop" alt="Baby" style="max-width:360px;width:100%">
    {% endif %}
    <h2>{{ section.settings.title }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>

  <div class="auth-form-wrap">
    <div class="auth-form">
      <div style="text-align:center;margin-bottom:var(--space-4)">
        <div style="font-family:var(--font-heading);font-size:2.5rem;color:var(--primary);margin-bottom:var(--space-1)">{{ shop.name }}</div>
        <h2 style="font-size:1.75rem;margin-bottom:var(--space-1)">Create Account</h2>
        <p style="color:var(--gray-500)">Join the SUMIX family in under a minute</p>
      </div>

      {% form 'create_customer' %}
        {{ form.errors | default_errors }}
        
        <div class="form-group">
          <label>First Name</label>
          <input type="text" name="customer[first_name]" class="input" placeholder="Your first name" required>
        </div>
        <div class="form-group">
          <label>Last Name</label>
          <input type="text" name="customer[last_name]" class="input" placeholder="Your last name" required>
        </div>
        <div class="form-group">
          <label>Email Address</label>
          <input type="email" name="customer[email]" class="input" placeholder="you@example.com" required>
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="customer[password]" class="input" placeholder="Create a password" required>
        </div>
        
        <button type="submit" class="btn btn-primary btn-full btn-lg">Create Account</button>
      {% endform %}

      <div style="margin:var(--space-4) 0;padding:var(--space-3);background:var(--primary-soft);border-radius:var(--radius-lg)">
        <div style="font-weight:700;color:var(--primary);margin-bottom:var(--space-1)">✨ Member Benefits</div>
        <ul style="font-size:0.875rem;color:var(--gray-600);display:flex;flex-direction:column;gap:4px">
          <li>🎁 Welcome coupon: ₹100 off first order</li>
          <li>⭐ Earn points on every purchase</li>
          <li>🎂 Birthday rewards & surprises</li>
          <li>🚀 Faster checkout experience</li>
        </ul>
      </div>

      <p style="text-align:center;font-size:0.9375rem;color:var(--gray-600)">
        Already have an account? <a href="{{ routes.account_login_url }}" style="color:var(--primary);font-weight:700">Sign in</a>
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Sumix Register",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Start Your Journey With Us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Create your account and unlock a world of soft, safe, and beautiful babywear designed with love."
    }
  ]
}
{% endschema %}
