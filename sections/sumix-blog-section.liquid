<section class="section">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      </div>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}" class="link-arrow">{{ section.settings.link_label }} →</a>
      {% endif %}
    </div>
    <div class="product-grid product-grid-3">
      {% assign blog = blogs[section.settings.blog] %}
      {% if blog != blank and blog.articles_count > 0 %}
        {% for article in blog.articles limit: section.settings.post_limit %}
          <article class="blog-card">
            <a href="{{ article.url }}">
              {% if article.image %}
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title }}">
              {% else %}
                <div style="width:100%; height:220px; background:#f4f4f4"></div>
              {% endif %}
            </a>
            <div class="blog-card-body">
              {% if article.tags.size > 0 %}
                <span class="blog-tag">{{ article.tags.first }}</span>
              {% endif %}
              <a href="{{ article.url }}">
                <h3>{{ article.title }}</h3>
              </a>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 15 }}</p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="blog-card">
            <div style="width:100%; height:220px; background:#f4f4f4"></div>
            <div class="blog-card-body">
              <span class="blog-tag">Tag {{ i }}</span>
              <h3>Example Article {{ i }}</h3>
              <p>Everything you need to know about fabrics, sizes, and seasonal layering.</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sumix Blog",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Parenting Journal"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tips, stories & inspiration for your journey"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View All Link Label",
      "default": "Read All"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View All Link"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of posts to show"
    }
  ],
  "presets": [
    {
      "name": "Sumix Blog"
    }
  ]
}
{% endschema %}
