{% style %}
  .product-info-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .product-info-sumix-{{ section.id }} .info-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    max-width: 650px;
  }
  
  {% if section.settings.alignment == 'center' %}
    .product-info-sumix-{{ section.id }} .info-wrapper {
      margin: 0 auto;
      text-align: center;
      align-items: center;
    }
    .product-info-sumix-{{ section.id }} .product-price-wrapper,
    .product-info-sumix-{{ section.id }} .product-rating {
      justify-content: center;
    }
  {% endif %}

  /* Text & Title */
  .product-info-sumix-{{ section.id }} .product-vendor {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gray-500);
    margin: 0;
  }

  .product-info-sumix-{{ section.id }} .product-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
  }

  /* Price */
  .product-info-sumix-{{ section.id }} .product-price-wrapper {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  
  .product-info-sumix-{{ section.id }} .product-price {
    font-size: 1.5rem;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }
  
  .product-info-sumix-{{ section.id }} .product-compare {
    font-size: 1.125rem;
    text-decoration: line-through;
    color: var(--gray-400);
  }
  
  .product-info-sumix-{{ section.id }} .sale-badge {
    background-color: #E2E8F0;
    color: #1E293B;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Rating */
  .product-info-sumix-{{ section.id }} .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--gray-500);
  }
  
  .product-info-sumix-{{ section.id }} .stars {
    color: {{ section.settings.star_color }};
    display: flex;
    gap: 2px;
  }
  
  .product-info-sumix-{{ section.id }} .stars svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  /* Description */
  .product-info-sumix-{{ section.id }} .product-description {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
  }

  /* Benefits Box */
  .product-info-sumix-{{ section.id }} .product-benefits {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: rgba(0,0,0,0.03);
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.05);
    width: 100%;
  }
  
  .product-info-sumix-{{ section.id }} .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: {{ section.settings.text_color }};
  }
  
  .product-info-sumix-{{ section.id }} .benefit-icon {
    color: {{ section.settings.icon_color }};
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  
  .product-info-sumix-{{ section.id }} .benefit-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Trust Badges */
  .product-info-sumix-{{ section.id }} .trust-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: 0.5rem;
    border-top: 1px solid rgba(0,0,0,0.05);
    width: 100%;
  }
  
  {% if section.settings.alignment == 'center' %}
    .product-info-sumix-{{ section.id }} .trust-badges {
      justify-content: center;
    }
  {% endif %}
  
  .product-info-sumix-{{ section.id }} .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.75rem;
    color: var(--gray-500);
    text-align: center;
  }
  
  .product-info-sumix-{{ section.id }} .trust-badge svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* Form & CTA */
  .product-info-sumix-{{ section.id }} .product-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  
  .product-info-sumix-{{ section.id }} .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid var(--gray-300);
    border-radius: var(--radius-full);
    width: max-content;
    overflow: hidden;
  }
  
  .product-info-sumix-{{ section.id }} .quantity-btn {
    background: none;
    border: none;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    cursor: pointer;
  }
  
  .product-info-sumix-{{ section.id }} .quantity-input {
    width: 40px;
    text-align: center;
    border: none;
    font-size: 1rem;
    font-weight: 600;
    -moz-appearance: textfield;
  }
  
  .product-info-sumix-{{ section.id }} .quantity-input::-webkit-outer-spin-button,
  .product-info-sumix-{{ section.id }} .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  
  .product-info-sumix-{{ section.id }} .btn-add {
    background: {{ section.settings.cta_bg_color | default: 'var(--primary)' }};
    color: {{ section.settings.cta_text_color | default: 'var(--white)' }};
    width: 100%;
    padding: 1.125rem;
    border: none;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 1.0625rem;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .product-info-sumix-{{ section.id }} .btn-add:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
{% endstyle %}

{%- assign target_product = product -%}
{%- if target_product == blank -%}
  <!-- Editor Fallback if not on a product page -->
{%- endif -%}

<div class="product-info-sumix-{{ section.id }}">
  <div class="info-wrapper">
    
    {% for block in section.blocks %}
      {% case block.type %}
        
        {% when 'vendor' %}
          <p class="product-vendor" {{ block.shopify_attributes }}>{{ target_product.vendor | default: 'Sumix Babywear' }}</p>
          
        {% when 'title' %}
          <h1 class="product-title" {{ block.shopify_attributes }}>{{ target_product.title | default: 'Premium Organic Cotton Romper' }}</h1>
          
        {% when 'rating' %}
          <div class="product-rating" {{ block.shopify_attributes }}>
            <div class="stars">
              {% for i in (1..5) %}
                <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              {% endfor %}
            </div>
            <span>{{ block.settings.review_count_text | default: '128 Reviews' }}</span>
          </div>

        {% when 'price' %}
          <div class="product-price-wrapper" {{ block.shopify_attributes }}>
            {%- assign current_variant = target_product.selected_or_first_available_variant -%}
            <span class="product-price">{{ current_variant.price | default: 129900 | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price or target_product == blank %}
              <span class="product-compare">{{ current_variant.compare_at_price | default: 159900 | money }}</span>
              <span class="sale-badge">Save {{ current_variant.compare_at_price | minus: current_variant.price | default: 30000 | money }}</span>
            {% endif %}
          </div>

        {% when 'description' %}
          <div class="product-description" {{ block.shopify_attributes }}>
            {% if target_product.description != blank %}
              {{ target_product.description | truncatewords: 30 }}
            {% else %}
              <p>Crafted from the softest, GOTS-certified organic cotton to keep your little one comfortable all day and night. Features smart two-way zippers for easy changes.</p>
            {% endif %}
          </div>

        {% when 'benefits' %}
          <div class="product-benefits" {{ block.shopify_attributes }}>
            {% if block.settings.benefit_1 != blank %}
              <div class="benefit-item">
                <div class="benefit-icon"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
                <span>{{ block.settings.benefit_1 }}</span>
              </div>
            {% endif %}
            {% if block.settings.benefit_2 != blank %}
              <div class="benefit-item">
                <div class="benefit-icon"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
                <span>{{ block.settings.benefit_2 }}</span>
              </div>
            {% endif %}
            {% if block.settings.benefit_3 != blank %}
              <div class="benefit-item">
                <div class="benefit-icon"><svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg></div>
                <span>{{ block.settings.benefit_3 }}</span>
              </div>
            {% endif %}
          </div>

        {% when 'buy_buttons' %}
          <div class="product-form" {{ block.shopify_attributes }}>
            {% form 'product', target_product %}
              <input type="hidden" name="id" value="{{ target_product.selected_or_first_available_variant.id | default: '1' }}">
              
              {% if block.settings.show_quantity %}
                <div style="margin-bottom: 1rem;">
                  <label style="display:block; font-size:0.875rem; font-weight:600; margin-bottom:0.5rem;">Quantity</label>
                  <div class="quantity-selector">
                    <button type="button" class="quantity-btn" onclick="this.nextElementSibling.stepDown()">-</button>
                    <input type="number" name="quantity" class="quantity-input" value="1" min="1">
                    <button type="button" class="quantity-btn" onclick="this.previousElementSibling.stepUp()">+</button>
                  </div>
                </div>
              {% endif %}

              <button type="submit" class="btn-add">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                {{ block.settings.button_text | default: 'Add to Cart' }}
              </button>
            {% endform %}
          </div>

        {% when 'trust_badges' %}
          <div class="trust-badges" {{ block.shopify_attributes }}>
            {% if block.settings.show_shipping %}
              <div class="trust-badge">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                <span>Free Shipping</span>
              </div>
            {% endif %}
            {% if block.settings.show_returns %}
              <div class="trust-badge">
                <svg viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                <span>Easy Returns</span>
              </div>
            {% endif %}
            {% if block.settings.show_secure %}
              <div class="trust-badge">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Secure Checkout</span>
              </div>
            {% endif %}
          </div>

      {% endcase %}
    {% endfor %}

  </div>
</div>

{% schema %}
{
  "name": "Sumix Enhanced Prod Info",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Rating Color",
      "default": "#FBBF24"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Benefit Icon Color",
      "default": "#10B981"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "Add to Cart Background",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Add to Cart Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "review_count_text",
          "label": "Review Text Fallback",
          "default": "128 Reviews"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Short Description",
      "limit": 1
    },
    {
      "type": "benefits",
      "name": "Benefits Box",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1",
          "default": "100% GOTS Certified Organic Cotton"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2",
          "default": "Hypoallergenic & Breathable"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3",
          "default": "Pre-washed for immediate softness"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Add to Cart"
        },
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show Quantity Selector",
          "default": true
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust Badges",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_shipping",
          "label": "Show Free Shipping",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_returns",
          "label": "Show Easy Returns",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_secure",
          "label": "Show Secure Checkout",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Enhanced Prod Info",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "rating" },
        { "type": "price" },
        { "type": "benefits" },
        { "type": "buy_buttons" },
        { "type": "trust_badges" }
      ]
    }
  ]
}
{% endschema %}
