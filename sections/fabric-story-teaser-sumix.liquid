{% style %}
  .fabric-story-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    overflow: hidden;
  }

  .fabric-story-sumix-{{ section.id }} .container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    display: flex;
    align-items: center;
    gap: 5rem;
  }

  {% if section.settings.layout == 'image_right' %}
    .fabric-story-sumix-{{ section.id }} .container {
      flex-direction: row-reverse;
    }
  {% endif %}

  .fabric-story-sumix-{{ section.id }} .story-image {
    flex: 1;
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.06);
  }

  .fabric-story-sumix-{{ section.id }} .story-image::before {
    content: "";
    display: block;
    padding-bottom: 120%; /* 5:6 Aspect Ratio */
  }

  .fabric-story-sumix-{{ section.id }} .story-image img,
  .fabric-story-sumix-{{ section.id }} .story-image svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fabric-story-sumix-{{ section.id }} .story-content {
    flex: 1;
    max-width: 540px;
  }

  .fabric-story-sumix-{{ section.id }} .story-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    color: {{ section.settings.text_color }};
  }

  .fabric-story-sumix-{{ section.id }} .story-text {
    font-size: 1.125rem;
    line-height: 1.6;
    opacity: 0.8;
    margin-bottom: 2.5rem;
    color: {{ section.settings.text_color }};
  }

  /* Material Highlights Blocks */
  .fabric-story-sumix-{{ section.id }} .highlights-grid {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .fabric-story-sumix-{{ section.id }} .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .fabric-story-sumix-{{ section.id }} .highlight-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    color: {{ section.settings.icon_color }};
    background: rgba(0,0,0,0.03);
    padding: 8px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fabric-story-sumix-{{ section.id }} .highlight-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .fabric-story-sumix-{{ section.id }} .highlight-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .fabric-story-sumix-{{ section.id }} .highlight-title {
    font-weight: 700;
    font-size: 1.0625rem;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .fabric-story-sumix-{{ section.id }} .highlight-text {
    font-size: 0.9375rem;
    opacity: 0.7;
    margin: 0;
    line-height: 1.4;
    color: {{ section.settings.text_color }};
  }

  .fabric-story-sumix-{{ section.id }} .btn-story {
    background-color: var(--primary);
    color: var(--white);
    border: none;
    padding: 1rem 2.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .fabric-story-sumix-{{ section.id }} .btn-story:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .fabric-story-sumix-{{ section.id }} .container {
      flex-direction: column !important;
      gap: 3rem;
    }
    
    .fabric-story-sumix-{{ section.id }} .story-image {
      width: 100%;
    }
    
    .fabric-story-sumix-{{ section.id }} .story-content {
      max-width: 100%;
      text-align: center;
    }
    
    .fabric-story-sumix-{{ section.id }} .highlight-item {
      text-align: left;
    }
  }
{% endstyle %}

<div class="fabric-story-sumix-{{ section.id }}">
  <div class="container">
    
    <div class="story-image">
      {% if section.settings.image != blank %}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" 
             alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" 
             loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="story-content">
      {% if section.settings.heading != blank %}
        <h2 class="story-title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="story-text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="highlights-grid">
          {% for block in section.blocks %}
            <div class="highlight-item" {{ block.shopify_attributes }}>
              
              <div class="highlight-icon">
                {% if block.settings.icon_svg != blank %}
                  {{ block.settings.icon_svg }}
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {% endif %}
              </div>
              
              <div class="highlight-content">
                {% if block.settings.title != blank %}
                  <h4 class="highlight-title">{{ block.settings.title }}</h4>
                {% endif %}
                
                {% if block.settings.text != blank %}
                  <p class="highlight-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
              
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <a href="{{ section.settings.cta_link }}" class="btn-story">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Sumix Fabric Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images & Layout"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial Image",
      "info": "Portrait images (4:5 or 5:6) work best."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image Placement",
      "options": [
        { "value": "image_left", "label": "Image Left" },
        { "value": "image_right", "label": "Image Right" }
      ],
      "default": "image_left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Softest Touch for Sensitive Skin"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Main Text",
      "default": "<p>We source only the finest GOTS-certified organic cotton to ensure every piece we create is breathable, durable, and exceptionally gentle on your baby's delicate skin.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F8F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2D2D2D"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Highlight Icon Color",
      "default": "#6D28D9"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Material Highlight",
      "limit": 3,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste raw SVG code for the icon."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Short Text",
          "default": "Grown without harmful chemicals or pesticides."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Fabric Story",
      "blocks": [
        {
          "type": "highlight",
          "settings": {
            "title": "GOTS Certified Organic",
            "text": "Ethically sourced and completely chemical-free.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Ultra-Breathable",
            "text": "Temperature regulating fibers keep your baby comfortable all year round.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>"
          }
        },
        {
          "type": "highlight",
          "settings": {
            "title": "Pre-Washed Softness",
            "text": "Garment washed to prevent shrinking and provide immediate comfort.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
