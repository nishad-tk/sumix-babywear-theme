<section class="section" style="background:var(--white)">
  <div class="container">
    <div class="section-header">
      <div>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      </div>
      {% if section.settings.link_label != blank %}
        <a href="{{ section.settings.link_url }}" class="link-arrow">{{ section.settings.link_label }} →</a>
      {% endif %}
    </div>
    <div class="category-grid">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="category-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.title }}">
          {% else %}
            <img src="https://images.unsplash.com/photo-1562157873-818bc0726f68?w=400&h=400&fit=crop" alt="Category placeholder">
          {% endif %}
          <div class="category-overlay"><h4>{{ block.settings.title }}</h4></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sumix Shop By Category",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated collections for every moment"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "View All Link Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "View All Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rompers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Shop By Category",
      "blocks": [
        { "type": "category", "settings": { "title": "Rompers" } },
        { "type": "category", "settings": { "title": "Onesies" } },
        { "type": "category", "settings": { "title": "Dresses" } },
        { "type": "category", "settings": { "title": "Sleepwear" } },
        { "type": "category", "settings": { "title": "Essentials" } },
        { "type": "category", "settings": { "title": "Gift Sets" } }
      ]
    }
  ]
}
{% endschema %}
