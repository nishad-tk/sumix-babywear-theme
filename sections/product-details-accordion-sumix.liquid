{% style %}
  .accordion-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .accordion-sumix-{{ section.id }} .container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .accordion-sumix-{{ section.id }} .section-header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: 2.5rem;
  }

  .accordion-sumix-{{ section.id }} .accordion-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .accordion-sumix-{{ section.id }} .accordion-subtitle {
    font-size: 1.0625rem;
    opacity: 0.7;
    margin: 0.5rem 0 0 0;
  }

  .accordion-sumix-{{ section.id }} .accordion-wrapper {
    border-top: 1px solid rgba(0,0,0,0.1);
  }

  .accordion-sumix-{{ section.id }} .accordion-item {
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .accordion-sumix-{{ section.id }} .accordion-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.0625rem;
    color: {{ section.settings.text_color }};
    list-style: none; /* Hide default marker */
    transition: opacity 0.2s;
  }
  
  .accordion-sumix-{{ section.id }} .accordion-summary:hover {
    opacity: 0.8;
  }

  .accordion-sumix-{{ section.id }} .accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-sumix-{{ section.id }} .summary-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .accordion-sumix-{{ section.id }} .summary-icon {
    width: 24px;
    height: 24px;
    color: {{ section.settings.text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .accordion-sumix-{{ section.id }} .summary-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .accordion-sumix-{{ section.id }} .chevron-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.text_color }};
  }

  .accordion-sumix-{{ section.id }} .chevron-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  /* Accessible smooth open */
  .accordion-sumix-{{ section.id }} details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .accordion-sumix-{{ section.id }} .accordion-content {
    padding-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.8;
    color: {{ section.settings.text_color }};
    padding-left: {% if section.blocks.first.settings.icon_svg != blank %}3rem{% else %}0{% endif %};
  }

  .accordion-sumix-{{ section.id }} .accordion-content a {
    color: inherit;
    text-decoration: underline;
  }
{% endstyle %}

<div class="accordion-sumix-{{ section.id }}">
  <div class="container">
    
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="section-header">
        {% if section.settings.heading != blank %}
          <h2 class="accordion-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="accordion-subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="accordion-wrapper">
        {% for block in section.blocks %}
          {% if block.settings.title != blank %}
            <details class="accordion-item" {{ block.shopify_attributes }} {% if section.settings.open_first and forloop.first %}open{% endif %}>
              <summary class="accordion-summary">
                <div class="summary-left">
                  {% if block.settings.icon_svg != blank %}
                    <span class="summary-icon">{{ block.settings.icon_svg }}</span>
                  {% endif %}
                  <span>{{ block.settings.title }}</span>
                </div>
                <span class="chevron-icon">
                  <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </span>
              </summary>
              <div class="accordion-content">
                {{ block.settings.content }}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Sumix Product Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Details"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 800,
      "info": "A narrower width is often easier to read for text-heavy accordions."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Keep first item open by default",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Border Color",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "accordion_item",
      "name": "Accordion Item",
      "limit": 8,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Optional Icon (SVG code)",
          "info": "Paste raw SVG code to display an icon next to the title."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Item Title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Provide detailed information here. You can connect this field to a dynamic source (metafield) by clicking the database icon above.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Product Accordion",
      "blocks": [
        {
          "type": "accordion_item",
          "settings": {
            "title": "Fabric & Care",
            "content": "<p>100% GOTS Certified Organic Cotton.<br><br>Machine wash cold with like colors. Tumble dry on low or line dry to preserve fabric softness.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Fit & Sizing",
            "content": "<p>Designed with a relaxed fit to allow room for growth. If your child is between sizes, we recommend sizing up.</p>"
          }
        },
        {
          "type": "accordion_item",
          "settings": {
            "title": "Delivery & Returns",
            "content": "<p>Orders are dispatched within 24 hours. We offer free shipping on orders over ₹999.<br><br>Not completely satisfied? We offer hassle-free 15-day returns.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
