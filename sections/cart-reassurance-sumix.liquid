{% style %}
  .cart-reassurance-sumix-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
  }

  .cart-reassurance-sumix-{{ section.id }} .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-box {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: 16px;
    padding: 3rem 2rem;
    {% if section.settings.show_border %}
      border: 1px solid rgba(0,0,0,0.06);
    {% endif %}
    {% if section.settings.show_shadow %}
      box-shadow: 0 10px 40px rgba(0,0,0,0.03);
    {% endif %}
  }

  .cart-reassurance-sumix-{{ section.id }} .box-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cart-reassurance-sumix-{{ section.id }} .box-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: {{ section.settings.text_color }};
  }

  .cart-reassurance-sumix-{{ section.id }} .box-text {
    font-size: 1rem;
    opacity: 0.8;
    margin: 0 auto;
    max-width: 600px;
    line-height: 1.5;
    color: {{ section.settings.text_color }};
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem 1.5rem;
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-icon {
    width: 48px;
    height: 48px;
    color: {{ section.settings.icon_color }};
    background: rgba(0,0,0,0.03);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-title {
    font-weight: 700;
    font-size: 1rem;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .cart-reassurance-sumix-{{ section.id }} .reassurance-text {
    font-size: 0.875rem;
    line-height: 1.4;
    opacity: 0.75;
    margin: 0;
    color: {{ section.settings.text_color }};
  }

  .cart-reassurance-sumix-{{ section.id }} .box-footer {
    text-align: center;
    margin-top: 3rem;
  }

  .cart-reassurance-sumix-{{ section.id }} .btn-upsell {
    display: inline-block;
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.card_bg_color }};
    padding: 1rem 2.5rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.2s ease;
  }

  .cart-reassurance-sumix-{{ section.id }} .btn-upsell:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .cart-reassurance-sumix-{{ section.id }} .reassurance-box {
      padding: 2rem 1.5rem;
    }
    .cart-reassurance-sumix-{{ section.id }} .reassurance-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cart-reassurance-sumix-{{ section.id }} .reassurance-item {
      flex-direction: row;
      text-align: left;
    }
    .cart-reassurance-sumix-{{ section.id }} .box-footer {
      margin-top: 2rem;
    }
    .cart-reassurance-sumix-{{ section.id }} .btn-upsell {
      width: 100%;
    }
  }
{% endstyle %}

<div class="cart-reassurance-sumix-{{ section.id }}">
  <div class="container">
    
    <div class="reassurance-box">
      
      {% if section.settings.heading != blank or section.settings.text != blank %}
        <div class="box-header">
          {% if section.settings.heading != blank %}
            <h2 class="box-title">{{ section.settings.heading }}</h2>
          {% endif %}
          
          {% if section.settings.text != blank %}
            <p class="box-text">{{ section.settings.text }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="reassurance-grid">
          {% for block in section.blocks %}
            <div class="reassurance-item" {{ block.shopify_attributes }}>
              
              <div class="reassurance-icon">
                {% if block.settings.icon_svg != blank %}
                  {{ block.settings.icon_svg }}
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                {% endif %}
              </div>
              
              <div class="reassurance-content">
                {% if block.settings.title != blank %}
                  <h4 class="reassurance-title">{{ block.settings.title }}</h4>
                {% endif %}
                
                {% if block.settings.text != blank %}
                  <p class="reassurance-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
              
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <div class="box-footer">
          <a href="{{ section.settings.cta_link }}" class="btn-upsell">{{ section.settings.cta_label }}</a>
        </div>
      {% endif %}

    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Sumix Cart Reassurance",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with Confidence"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "We guarantee the highest quality for your little ones."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "Continue Shopping"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Box Styling"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Soft Border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show Subtle Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Inner Box Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#10B981"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Reassurance Item",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG Code",
          "info": "Paste raw SVG code here."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Short reassuring message."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Cart Reassurance",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Secure Checkout",
            "text": "Your payment info is 100% safe.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Shipping",
            "text": "On all orders above ₹999.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"></rect><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"></polygon><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"></circle><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"></circle></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Easy Returns",
            "text": "15-day hassle-free returns.",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><polyline points=\"1 4 1 10 7 10\"></polyline><polyline points=\"23 20 23 14 17 14\"></polyline><path d=\"M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15\"></path></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
