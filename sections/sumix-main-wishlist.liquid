<main style="padding-top:var(--space-4)">
  <div class="container">
    <div class="section-header">
      <div>
        <h1 class="text-h1">{{ page.title }} <span style="font-size:1.25rem;color:var(--coral)">🤍</span></h1>
        <p class="section-subtitle">Your saved items</p>
      </div>
      <div style="display:flex;gap:var(--space-2)">
        <button class="btn btn-ghost btn-sm" onclick="showToast('Feature coming soon', 'info')">Share wishlist</button>
      </div>
    </div>

    <!-- The wishlist grid is populated by JS from localStorage just like the original static HTML, but adapted for Shopify -->
    <div class="wishlist-grid" id="wishlist-grid">
      <!-- Populated by app.js -->
    </div>
    
    <div id="wishlist-empty" style="display:none; text-align:center; padding:var(--space-8) 0">
      <h2 style="font-family:var(--font-heading);font-size:2rem;margin-bottom:var(--space-3)">Your Wishlist is Empty</h2>
      <p style="color:var(--gray-500);margin-bottom:var(--space-4)">Save your favorite items here to view them later.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">Start Shopping</a>
    </div>

    <!-- Recently Viewed -->
    <section style="margin-top:var(--space-10)">
      <div class="section-header">
        <div>
          <h2 class="section-title">Recently Viewed</h2>
        </div>
        <a href="{{ routes.all_products_collection_url }}" class="link-arrow">View All →</a>
      </div>
      <div class="product-grid">
        {% for product in collections.all.products limit: 4 %}
          <div class="product-card">
            <div class="product-image">
              <a href="{{ product.url }}">
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}">
              </a>
            </div>
            <div class="product-info">
              <a href="{{ product.url }}"><h4 class="product-name">{{ product.title }}</h4></a>
              <div class="product-price"><span class="price-current">{{ product.price | money }}</span></div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
</main>

<script>
  // Quick initialization to show empty state if wishlist is empty
  document.addEventListener('DOMContentLoaded', function() {
    if(!Store || !Store.wishlist || Store.wishlist.length === 0) {
      document.getElementById('wishlist-empty').style.display = 'block';
    }
  });
</script>

{% schema %}
{
  "name": "Sumix Wishlist",
  "settings": []
}
{% endschema %}
