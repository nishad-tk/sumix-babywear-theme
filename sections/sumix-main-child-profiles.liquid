<main style="padding-top:var(--space-4)">
  <div class="container">
    <div class="account-layout">
      <!-- Sidebar -->
      <aside class="account-sidebar">
        <nav class="account-nav">
          <a href="{{ routes.account_url }}" class="account-nav-item">🏠 Dashboard</a>
          <a href="{{ routes.account_url }}#orders" class="account-nav-item">📦 Orders</a>
          <a href="/pages/child-profiles" class="account-nav-item active">👶 Child Profiles</a>
          <a href="/pages/wishlist" class="account-nav-item">🤍 Wishlist</a>
          <a href="/pages/rewards" class="account-nav-item">🎁 Rewards</a>
          <a href="{{ routes.account_addresses_url }}" class="account-nav-item">📍 Addresses</a>
          <a href="{{ routes.account_logout_url }}" class="account-nav-item">🚪 Logout</a>
        </nav>
      </aside>

      <!-- Main Content -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)">
          <div>
            <h1 class="text-h1">Child Profiles</h1>
            <p style="color:var(--gray-500)">Manage your little one's details for a personalized shopping experience</p>
          </div>
          <button class="btn btn-primary" onclick="showToast('Feature coming soon', 'info')">+ Add Child</button>
        </div>

        <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-3);margin-bottom:var(--space-4)">
          <!-- Static Profile 1 -->
          <div class="child-card active">
            <div class="child-card-header">
              <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?w=150&h=150&fit=crop" class="child-avatar" alt="Aarvi">
              <div>
                <h4>Aarvi</h4>
                <p>2 years 4 months • Girl</p>
                <p style="font-size:0.75rem;color:var(--gray-400)">Born Jun 10, 2022</p>
              </div>
              <span style="margin-left:auto;padding:0.25rem 0.75rem;background:var(--primary);color:var(--white);font-size:0.75rem;font-weight:700;border-radius:var(--radius-full)">Active</span>
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-2);margin-bottom:var(--space-3)">
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Current Size</div>
                <div style="font-weight:700">2-3Y</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Height</div>
                <div style="font-weight:700">92 cm</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Weight</div>
                <div style="font-weight:700">13.2 kg</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Next Size Up</div>
                <div style="font-weight:700">3-4Y</div>
              </div>
            </div>
            <div style="display:flex;gap:var(--space-2)">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-sm" style="flex:1">Shop for Aarvi</a>
              <button class="btn btn-ghost btn-sm">Edit Profile</button>
            </div>
          </div>
          
          <!-- Static Profile 2 -->
          <div class="child-card">
            <div class="child-card-header">
              <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=150&h=150&fit=crop" class="child-avatar" alt="Vivaan">
              <div>
                <h4>Vivaan</h4>
                <p>1 year 2 months • Boy</p>
                <p style="font-size:0.75rem;color:var(--gray-400)">Born Aug 18, 2023</p>
              </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-2);margin-bottom:var(--space-3)">
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Current Size</div>
                <div style="font-weight:700">12-18M</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Height</div>
                <div style="font-weight:700">78 cm</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Weight</div>
                <div style="font-weight:700">10.5 kg</div>
              </div>
              <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                <div style="font-size:0.75rem;color:var(--gray-500)">Next Size Up</div>
                <div style="font-weight:700">18-24M</div>
              </div>
            </div>
            <div style="display:flex;gap:var(--space-2)">
              <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-sm" style="flex:1">Shop for Vivaan</a>
              <button class="btn btn-ghost btn-sm">Edit Profile</button>
            </div>
          </div>
        </div>

        <!-- Growth Timeline -->
        <div class="account-main" style="margin-bottom:var(--space-4)">
          <h3 style="font-family:var(--font-heading);font-size:1.25rem;margin-bottom:var(--space-3)">Growth Timeline</h3>
          <div class="timeline">
            <div class="timeline-item">
              <div style="font-weight:700">Born</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">Jun 10, 2022 • 3.2 kg • 50 cm</div>
            </div>
            <div class="timeline-item">
              <div style="font-weight:700">First Steps</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">Dec 15, 2022 • 11 months</div>
            </div>
            <div class="timeline-item">
              <div style="font-weight:700">First Words</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">Mar 20, 2023 • 14 months</div>
            </div>
            <div class="timeline-item">
              <div style="font-weight:700">Current</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">Today • 2 years 4 months</div>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </div>
</main>

{% schema %}
{
  "name": "Sumix Child Profiles",
  "settings": []
}
{% endschema %}
