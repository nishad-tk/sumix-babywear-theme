<main style="padding-top:var(--space-4); padding-bottom:var(--space-10);">
  <div class="container">
    <div class="account-layout">
      <!-- Sidebar -->
      <aside class="account-sidebar">
        <div style="font-weight:700; padding:var(--space-2) var(--space-3); color:var(--gray-500); font-size:0.875rem; text-transform:uppercase; letter-spacing:1px">Member Hub</div>
        <nav class="account-nav">
          <a href="/pages/rewards" class="account-nav-item">🎁 SUMIX Tokens</a>
          <a href="/pages/child-profiles" class="account-nav-item active">👶 Child Profiles</a>
          <a href="/pages/wishlist" class="account-nav-item">🤍 Wishlist</a>
        </nav>
        
        <div style="font-weight:700; padding:var(--space-4) var(--space-3) var(--space-2); color:var(--gray-500); font-size:0.875rem; text-transform:uppercase; letter-spacing:1px">Store Account</div>
        <nav class="account-nav">
          <a href="{{ routes.account_url }}" class="account-nav-item">📦 Orders & Addresses <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left:auto"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></a>
          <a href="{{ routes.account_logout_url }}" class="account-nav-item">🚪 Logout</a>
        </nav>
      </aside>

      <!-- Main Content -->
      <div>
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-4)">
          <div>
            <h1 class="text-h1">Child Profiles</h1>
            <p style="color:var(--gray-500)">Manage your little one's details for a personalized shopping experience</p>
          </div>
          <button class="btn btn-primary" onclick="document.getElementById('add-child-modal').classList.add('active')">+ Add Child</button>
        </div>

        {% if customer %}
          {% assign children = customer.metafields.sumix.children.value %}
          
          {% if children != blank and children.size > 0 %}
            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:var(--space-3);margin-bottom:var(--space-4)">
              {% for child in children %}
                <!-- Dynamic Profile -->
                <div class="child-card {% if forloop.first %}active{% endif %}">
                  <div class="child-card-header">
                    {% if child.photo != blank %}
                      <img src="{{ child.photo }}" class="child-avatar" alt="{{ child.name }}">
                    {% else %}
                      <div class="child-avatar" style="background:var(--primary-soft); display:flex; align-items:center; justify-content:center; color:var(--primary); font-weight:700">{{ child.name | slice: 0 }}</div>
                    {% endif %}
                    
                    <div>
                      <h4>{{ child.name }}</h4>
                      <p>{{ child.age_string }} • {{ child.gender }}</p>
                      <p style="font-size:0.75rem;color:var(--gray-400)">Born {{ child.dob | date: "%b %d, %Y" }}</p>
                    </div>
                    {% if forloop.first %}
                      <span style="margin-left:auto;padding:0.25rem 0.75rem;background:var(--primary);color:var(--white);font-size:0.75rem;font-weight:700;border-radius:var(--radius-full)">Primary</span>
                    {% endif %}
                  </div>
                  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-2);margin-bottom:var(--space-3)">
                    <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                      <div style="font-size:0.75rem;color:var(--gray-500)">Current Size</div>
                      <div style="font-weight:700">{{ child.current_size | default: 'N/A' }}</div>
                    </div>
                    <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                      <div style="font-size:0.75rem;color:var(--gray-500)">Height</div>
                      <div style="font-weight:700">{{ child.height | default: '--' }} cm</div>
                    </div>
                    <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                      <div style="font-size:0.75rem;color:var(--gray-500)">Weight</div>
                      <div style="font-weight:700">{{ child.weight | default: '--' }} kg</div>
                    </div>
                    <div style="padding:var(--space-2);background:var(--cream);border-radius:var(--radius-md)">
                      <div style="font-size:0.75rem;color:var(--gray-500)">Next Size Up</div>
                      <div style="font-weight:700">{{ child.next_size | default: 'N/A' }}</div>
                    </div>
                  </div>
                  <div style="display:flex;gap:var(--space-2)">
                    <a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.age_group={{ child.current_size | url_encode }}" class="btn btn-primary btn-sm" style="flex:1">Shop for {{ child.name }}</a>
                    <button class="btn btn-ghost btn-sm" onclick="editChild('{{ child.id }}')">Edit</button>
                    <button class="btn btn-ghost btn-sm" onclick="deleteChild('{{ child.id }}')" style="color:var(--error)">Delete</button>
                  </div>
                </div>
              {% endfor %}
            </div>
            
          {% else %}
            <!-- Empty State -->
            <div style="text-align:center; padding:var(--space-8); background:var(--cream); border-radius:var(--radius-xl); margin-bottom:var(--space-6)">
              <div style="font-size:3rem; margin-bottom:var(--space-3)">👶</div>
              <h3 style="font-family:var(--font-heading); margin-bottom:var(--space-2)">No Child Profiles Yet</h3>
              <p style="color:var(--gray-600); margin-bottom:var(--space-4)">Add your little ones to get personalized size recommendations and birthday rewards.</p>
              <button class="btn btn-primary" onclick="document.getElementById('add-child-modal').classList.add('active')">Create First Profile</button>
            </div>
          {% endif %}
        {% else %}
          <div style="text-align:center; padding:var(--space-8);">
            <p style="margin-bottom:var(--space-4)">Please log in to manage child profiles.</p>
            <a href="{{ routes.account_login_url }}" class="btn btn-primary">Login</a>
          </div>
        {% endif %}
        
        <!-- Growth Timeline -->
        <div class="account-main" style="margin-bottom:var(--space-4)">
          <h3 style="font-family:var(--font-heading);font-size:1.25rem;margin-bottom:var(--space-3)">Milestone Reminders (Preview)</h3>
          <p style="color:var(--gray-500); font-size:0.875rem; margin-bottom:var(--space-4)">Add your child's birth date to automatically generate milestone timelines.</p>
          <div class="timeline" style="opacity:0.5">
            <div class="timeline-item">
              <div style="font-weight:700">Born</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">--</div>
            </div>
            <div class="timeline-item">
              <div style="font-weight:700">First Birthday</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">12 months</div>
            </div>
            <div class="timeline-item">
              <div style="font-weight:700">Starting Toddler Sizes</div>
              <div style="font-size:0.8125rem;color:var(--gray-500)">2 years</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Add Child Modal Form -->
<div class="sumix-modal" id="add-child-modal">
  <div class="sumix-modal-content">
    <button class="sumix-modal-close" onclick="document.getElementById('add-child-modal').classList.remove('active')">&times;</button>
    <h2 style="font-family:var(--font-heading); margin-bottom:var(--space-4)">Add Child Profile</h2>
    <form id="add-child-form" onsubmit="event.preventDefault(); submitChildForm(this);">
      <div style="display:grid; gap:var(--space-3)">
        <div>
          <label class="label">Child's Name</label>
          <input type="text" name="name" class="input" required>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3)">
          <div>
            <label class="label">Date of Birth</label>
            <input type="date" name="dob" class="input" required>
          </div>
          <div>
            <label class="label">Gender</label>
            <select name="gender" class="input">
              <option value="Girl">Girl</option>
              <option value="Boy">Boy</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-3)">
          <div>
            <label class="label">Height (cm) <span style="color:var(--gray-400)">Optional</span></label>
            <input type="number" name="height" class="input">
          </div>
          <div>
            <label class="label">Weight (kg) <span style="color:var(--gray-400)">Optional</span></label>
            <input type="number" name="weight" step="0.1" class="input">
          </div>
        </div>
      </div>
      <div style="margin-top:var(--space-6); display:flex; gap:var(--space-3); justify-content:flex-end">
        <button type="button" class="btn btn-ghost" onclick="document.getElementById('add-child-modal').classList.remove('active')">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Profile</button>
      </div>
    </form>
  </div>
</div>

<script>
  function submitChildForm(form) {
    // In a production Shopify environment without an App Proxy, Metafields cannot be written via frontend JS.
    // This script mocks the API call and prompts the user that an App is required for persistence.
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.innerHTML = 'Saving...';
    btn.disabled = true;

    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.disabled = false;
      document.getElementById('add-child-modal').classList.remove('active');
      alert("Success! Note: To persist this data to Shopify Customer Metafields permanently, a Shopify App or Storefront API connection is required on the backend.");
    }, 1000);
  }

  function editChild(id) {
    alert("Edit functionality requires the Metafield JSON array to be updated via Storefront API.");
  }

  function deleteChild(id) {
    if(confirm("Are you sure you want to remove this profile?")) {
      alert("Delete requested. Requires backend API to execute.");
    }
  }
</script>

{% schema %}
{
  "name": "Sumix Child Profiles",
  "settings": []
}
{% endschema %}
