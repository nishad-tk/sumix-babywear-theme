{% style %}
  .home-hero-sumix-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: {{ section.settings.vertical_alignment }};
    justify-content: {{ section.settings.horizontal_alignment }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 5%;
    padding-right: 5%;
    min-height: {{ section.settings.section_height_desktop }};
    overflow: hidden;
    background-color: var(--gray-100);
  }

  @media (max-width: 767px) {
    .home-hero-sumix-{{ section.id }} {
      min-height: {{ section.settings.section_height_mobile }};
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      align-items: {{ section.settings.vertical_alignment_mobile }};
      justify-content: {{ section.settings.horizontal_alignment_mobile }};
    }
  }

  .home-hero-sumix-{{ section.id }} .home-hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .home-hero-sumix-{{ section.id }} .home-hero-bg picture,
  .home-hero-sumix-{{ section.id }} .home-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .home-hero-sumix-{{ section.id }} .home-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
    pointer-events: none;
  }

  .home-hero-sumix-{{ section.id }} .home-hero-content {
    position: relative;
    z-index: 3;
    max-width: {{ section.settings.content_width }}px;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.text_color }};
    width: 100%;
  }

  @media (max-width: 767px) {
    .home-hero-sumix-{{ section.id }} .home-hero-content {
      text-align: {{ section.settings.text_alignment_mobile }};
    }
  }

  .home-hero-sumix-{{ section.id }} .hero-eyebrow {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: block;
  }

  .home-hero-sumix-{{ section.id }} .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.1;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: {{ section.settings.text_color }};
  }

  .home-hero-sumix-{{ section.id }} .hero-text {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .home-hero-sumix-{{ section.id }} .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  @media (max-width: 767px) {
    .home-hero-sumix-{{ section.id }} .hero-buttons {
      justify-content: {% if section.settings.text_alignment_mobile == 'center' %}center{% elsif section.settings.text_alignment_mobile == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
  }

  /* Specific styles to handle Sumix button overrides if needed */
  .home-hero-sumix-{{ section.id }} .btn-hero-primary {
    background-color: {{ section.settings.primary_btn_bg }};
    color: {{ section.settings.primary_btn_text }};
    border-color: {{ section.settings.primary_btn_bg }};
  }
  
  .home-hero-sumix-{{ section.id }} .btn-hero-primary:hover {
    filter: brightness(0.9);
    color: {{ section.settings.primary_btn_text }};
  }

  .home-hero-sumix-{{ section.id }} .btn-hero-secondary {
    background-color: {{ section.settings.secondary_btn_bg }};
    color: {{ section.settings.secondary_btn_text }};
    border: 1px solid {{ section.settings.secondary_btn_border }};
  }

  .home-hero-sumix-{{ section.id }} .btn-hero-secondary:hover {
    background-color: {{ section.settings.secondary_btn_border }};
    color: {{ section.settings.secondary_btn_text }};
  }

  .home-hero-sumix-{{ section.id }} .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.badge_spacing }}px;
    margin-top: 3rem;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  @media (max-width: 767px) {
    .home-hero-sumix-{{ section.id }} .trust-badges {
      margin-top: 2rem;
      justify-content: {% if section.settings.text_alignment_mobile == 'center' %}center{% elsif section.settings.text_alignment_mobile == 'right' %}flex-end{% else %}flex-start{% endif %};
    }
  }

  .home-hero-sumix-{{ section.id }} .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .home-hero-sumix-{{ section.id }} .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }
  
  .home-hero-sumix-{{ section.id }} .trust-badge-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  .home-hero-sumix-{{ section.id }} .trust-badge-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
{% endstyle %}

<div class="home-hero-sumix-{{ section.id }}">
  <div class="home-hero-bg">
    {% if section.settings.desktop_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 800 }}">
        {% endif %}
        <img src="{{ section.settings.desktop_image | image_url: width: 2000 }}" 
             alt="{{ section.settings.desktop_image.alt | default: section.settings.heading | escape }}"
             loading="{% if section.settings.lazy_load %}lazy{% else %}eager{% endif %}"
             width="{{ section.settings.desktop_image.width }}"
             height="{{ section.settings.desktop_image.height }}">
      </picture>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <div class="home-hero-overlay"></div>

  <div class="home-hero-content">
    {% if section.settings.eyebrow != blank %}
      <span class="hero-eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="hero-title">{{ section.settings.heading }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="hero-text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.settings.btn_1_label != blank or section.settings.btn_2_label != blank %}
      <div class="hero-buttons">
        {% if section.settings.btn_1_label != blank %}
          <a href="{{ section.settings.btn_1_link }}" class="btn btn-primary btn-hero-primary">{{ section.settings.btn_1_label }}</a>
        {% endif %}
        {% if section.settings.btn_2_label != blank %}
          <a href="{{ section.settings.btn_2_link }}" class="btn btn-hero-secondary">{{ section.settings.btn_2_label }}</a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="trust-badges">
        {% for block in section.blocks %}
          <div class="trust-badge-item" {{ block.shopify_attributes }}>
            {% if block.settings.icon_image != blank %}
              <div class="trust-badge-icon">
                <img src="{{ block.settings.icon_image | image_url: width: 48 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
              </div>
            {% elsif block.settings.icon_svg != blank %}
              <div class="trust-badge-icon">
                {{ block.settings.icon_svg }}
              </div>
            {% endif %}
            
            {% if block.settings.title != blank %}
              <span>{{ block.settings.title }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sumix Homepage Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image (Optional)",
      "info": "If left blank, the desktop image will be used."
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Lazy load image",
      "info": "Disable if this section is the first thing visible on screen.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "New Arrivals"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Softest Organics for Your Little One"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Subheading",
      "default": "<p>Thoughtfully designed babywear crafted for everyday joy and comfort.</p>"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "Primary Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "btn_1_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Secondary Button Label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "btn_2_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Layout (Desktop)"
    },
    {
      "type": "select",
      "id": "section_height_desktop",
      "label": "Section Height",
      "options": [
        { "value": "500px", "label": "Small" },
        { "value": "650px", "label": "Medium" },
        { "value": "800px", "label": "Large" },
        { "value": "100vh", "label": "Full Screen" }
      ],
      "default": "650px"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "Horizontal Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Max Content Width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 650
    },
    {
      "type": "header",
      "content": "Layout (Mobile)"
    },
    {
      "type": "select",
      "id": "section_height_mobile",
      "label": "Section Height",
      "options": [
        { "value": "400px", "label": "Small" },
        { "value": "500px", "label": "Medium" },
        { "value": "600px", "label": "Large" },
        { "value": "100vh", "label": "Full Screen" }
      ],
      "default": "500px"
    },
    {
      "type": "select",
      "id": "vertical_alignment_mobile",
      "label": "Vertical Alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_mobile",
      "label": "Horizontal Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors & Overlays"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "color",
      "id": "primary_btn_bg",
      "label": "Primary Button Background",
      "default": "#6D28D9"
    },
    {
      "type": "color",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_btn_bg",
      "label": "Secondary Button Background",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "secondary_btn_border",
      "label": "Secondary Button Border",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding (Desktop)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Trust Badges Layout"
    },
    {
      "type": "range",
      "id": "badge_spacing",
      "label": "Badge Spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Upload an icon (PNG/SVG recommended)"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Icon SVG (Fallback)",
          "info": "Paste raw SVG code if not using an image above"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Text",
          "default": "100% Organic"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sumix Homepage Hero",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "title": "GOTS Certified",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg>"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "title": "Soft on Skin",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "title": "Free Shipping",
            "icon_svg": "<svg viewBox=\"0 0 24 24\"><path d=\"M22 11h-4l-3-9H3a2 2 0 0 0-2 2v16h2a3 3 0 0 0 6 0h6a3 3 0 0 0 6 0h1a2 2 0 0 0 2-2v-5c0-1.66-1.34-3-3-3zm-13 9a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm8 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm-1.5-6h-11V6h9.5l2.67 8z\"/></svg>"
          }
