<section class="section">
  <div class="container">
    <div class="newsletter-section">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
      
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          id="NewsletterForm--{{ section.id }}"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          required
        >
        <button type="submit" class="btn btn-lg">{{ section.settings.btn_label }}</button>
      {% endform %}
      
      <p style="font-size:0.875rem;opacity:0.7;margin-top:var(--space-3)">{{ section.settings.footer_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sumix Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Stay in the Loop"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Get early access to new arrivals, exclusive offers & parenting tips delivered to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "Join 50,000+ parents. No spam, unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Sumix Newsletter"
    }
  ]
}
{% endschema %}
